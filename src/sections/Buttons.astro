---
---
<section class="flex flex-col gap-10 w-full max-w-5xl mx-auto py-16 px-4">
  <div class="flex flex-col gap-3">
    <h2 class="text-4xl font-bold font-poppins tracking-tight">Botones</h2>
  </div>

  <div class="flex flex-col gap-10">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse min-w-150">
        <thead>
          <tr class="border-b border-white/10 font-inter text-text-muted text-sm uppercase tracking-wider">
            <th class="pb-4 font-normal w-1/4">Tipo</th>
            <th class="pb-4 font-normal w-1/4">Default</th>
            <th class="pb-4 font-normal w-1/4">Hover</th>
            <th class="pb-4 font-normal w-1/4">Disabled</th>
          </tr>
        </thead>
        <tbody class="font-poppins">
          <!-- Primary -->
          <tr class="border-b border-white/5">
            <td class="py-8 font-semibold text-text">Primario</td>
            <td class="py-8">
              <button class="px-6 py-3 bg-primary text-background font-semibold rounded-full">Primario</button>
            </td>
            <td class="py-8">
              <button class="px-6 py-3 bg-[#00a8c4] text-background font-semibold rounded-full">Primario</button>
            </td>
            <td class="py-8">
              <button class="px-6 py-3 bg-primary/30 text-background/50 font-semibold rounded-full cursor-not-allowed">Primario</button>
            </td>
          </tr>
          
          <!-- Secondary -->
          <tr class="border-b border-white/5">
            <td class="py-8 font-semibold text-text">Secundario</td>
            <td class="py-8">
              <button class="px-6 py-3 bg-secondary text-background font-semibold rounded-full">Secundario</button>
            </td>
            <td class="py-8">
              <button class="px-6 py-3 bg-[#e6e6e6] text-background font-semibold rounded-full">Secundario</button>
            </td>
            <td class="py-8">
              <button class="px-6 py-3 bg-secondary/30 text-background/50 font-semibold rounded-full cursor-not-allowed">Secundario</button>
            </td>
          </tr>

          <!-- Accent -->
          <tr class="border-b border-white/5">
            <td class="py-8 font-semibold text-text">Acento</td>
            <td class="py-8">
              <button class="px-6 py-3 bg-accent text-secondary font-semibold rounded-full">Acento</button>
            </td>
            <td class="py-8">
              <button class="px-6 py-3 bg-[#e0127b] text-secondary font-semibold rounded-full">Acento</button>
            </td>
            <td class="py-8">
              <button class="px-6 py-3 bg-accent/30 text-secondary/50 font-semibold rounded-full cursor-not-allowed">Acento</button>
            </td>
          </tr>
          
          <!-- Outline -->
          <tr class="border-b border-white/5">
            <td class="py-8 font-semibold text-text">Contorno</td>
            <td class="py-8">
              <button class="px-6 py-3 bg-transparent border-2 border-primary text-primary font-semibold rounded-full">Contorno</button>
            </td>
            <td class="py-8">
              <button class="px-6 py-3 bg-primary/10 border-2 border-primary text-primary font-semibold rounded-full">Contorno</button>
            </td>
            <td class="py-8">
              <button class="px-6 py-3 bg-transparent border-2 border-primary/30 text-primary/30 font-semibold rounded-full cursor-not-allowed">Contorno</button>
            </td>
          </tr>

          <!-- Texto / Fantasma -->
          <tr>
            <td class="py-8 font-semibold text-text">Texto</td>
            <td class="py-8">
              <button class="px-6 py-3 bg-transparent text-text font-semibold rounded-full">Fantasma</button>
            </td>
            <td class="py-8">
              <button class="px-6 py-3 bg-secondary/10 text-text font-semibold rounded-full">Fantasma</button>
            </td>
            <td class="py-8">
              <button class="px-6 py-3 bg-transparent text-text/30 font-semibold rounded-full cursor-not-allowed">Fantasma</button>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>
